{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerConfiguracion",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SesionRemotaSoloEstaInstancia",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:us-east-1:449406670394:instance/i-000e8e7547c3ca69d",
        "arn:aws:ssm:us-east-1::document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "SusPropiasSesiones",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
    }
  ]
}
