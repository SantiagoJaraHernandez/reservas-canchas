{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerConfiguracionDeSeguridad",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SesionRemotaSoloEnLaInstanciaDelProyecto",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": { "ssm:resourceTag/Proyecto": "reservas-canchas" }
      }
    },
    {
      "Sid": "DocumentoDeSesion",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:*:*:document/SSM-SessionManagerRunShell"
    },
    {
      "Sid": "TerminarSusPropiasSesiones",
      "Effect": "Allow",
      "Action": ["ssm:TerminateSession", "ssm:ResumeSession"],
      "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
    }
  ]
}
